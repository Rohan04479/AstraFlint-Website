PORT=3000
# Create a free MongoDB Atlas database and paste its connection string here.
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/astraflint?retryWrites=true&w=majority
# Replace with a long random secret (at least 32 characters).
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_EMAIL=admin@example.com
# Generate this hash with: node -e "require('bcryptjs').hash('YourStrongPasswordHere', 12).then(console.log)"
ADMIN_PASSWORD_HASH=PASTE_BCRYPT_HASH_HERE
